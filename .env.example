# PetSafe AI - Environment Configuration Example
# Copy this file to .env.local for local development.
# NEVER commit production API keys or credentials to public Git repositories.

# Provider-Independent AI Vision / Cloud Proxy Endpoint
# Leave blank to use 100% offline verified veterinary database (zero cost, zero keys required).
# When connecting a backend server proxy, set its URL here:
VITE_BACKEND_AI_URL=

# AI Provider Type: "local" (default) | "gemini" | "openai"
VITE_AI_PROVIDER=local

# Application Environment
VITE_APP_ENV=production
